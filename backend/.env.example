# Copiar como .env y ajustar si hace falta
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jugueteria
JWT_SECRET=cambiar-este-secreto

# Recuperar contraseña: servidor de correo. Sin SMTP_HOST el mail no se envía y se muestra en la consola.
# Para probar sin mandar mails de verdad sirve Mailpit (viene con Laragon): SMTP_HOST=localhost y SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Juguetería <no-responder@jugueteria.com>
# Dirección con la que se abre la web: es la que va en el enlace del mail (en la red local, la IP de la PC)
URL_WEB=http://localhost:3000
