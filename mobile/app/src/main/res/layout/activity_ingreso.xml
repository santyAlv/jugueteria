<?xml version="1.0" encoding="utf-8"?>
<!-- Registrar Ingreso + Actualización de Stock sobre un producto existente -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <include layout="@layout/encabezado" />

        <TextView style="@style/Titulo" android:text="Ingreso de mercadería" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/fila"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/negro"
                android:textSize="21sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/gris"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/txtPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/negro"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/txtStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/rosa_oscuro"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/Etiqueta" android:text="Cantidad que ingresa:" />
        <EditText
            android:id="@+id/txtCantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unidades..."
            android:inputType="number"
            android:maxLength="6" />

        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Registrar ingreso" />

        <TextView
            android:id="@+id/btnModificar"
            style="@style/Enlace"
            android:layout_gravity="center_horizontal"
            android:text="Modificar información del producto" />

        <TextView style="@style/Etiqueta" android:text="Últimos movimientos:" />
        <LinearLayout
            android:id="@+id/listaMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
