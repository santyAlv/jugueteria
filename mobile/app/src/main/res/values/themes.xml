<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Jugueteria" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/rosa</item>
        <item name="colorPrimaryDark">@color/rosa_oscuro</item>
        <item name="colorAccent">@color/rosa</item>
        <item name="android:windowBackground">@color/blanco</item>
        <item name="android:statusBarColor">@color/rosa</item>
        <item name="android:textColorPrimary">@color/negro</item>
        <item name="buttonStyle">@style/Boton</item>
        <item name="editTextStyle">@style/Campo</item>
    </style>

    <style name="Boton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/boton</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Boton.Lila">
        <item name="android:background">@drawable/boton_lila</item>
    </style>

    <style name="Campo" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/campo</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/negro</item>
        <item name="android:textColorHint">@color/gris</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/negro</item>
    </style>

    <style name="Titulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/negro</item>
    </style>

    <style name="Enlace">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">@color/celeste</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Separador">
        <item name="android:layout_width">1.5dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@color/celeste</item>
    </style>
</resources>
