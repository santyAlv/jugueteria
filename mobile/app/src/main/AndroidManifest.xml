<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- usesCleartextTraffic: la API corre en la red local por http -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/logo"
        android:label="Juguetería"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jugueteria"
        android:usesCleartextTraffic="true">

        <!-- Primera pantalla: configuración de IP y puerto del servidor -->
        <activity
            android:name=".ConfiguracionActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MenuActivity" android:screenOrientation="portrait" />
        <activity android:name=".ProductosActivity" android:screenOrientation="portrait" />
        <activity android:name=".EscanerActivity" android:screenOrientation="portrait" />
        <activity
            android:name=".ProductoActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".IngresoActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
